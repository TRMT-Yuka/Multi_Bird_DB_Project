      <mxCell id="out_C23" edge="1" parent="1" source="C23" target="O23" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;"/>
      <mxCell id="C24" value="12A make run-exp1-simmatrix&#xa;入力：selected/complete runs&#xa;処理：共通QID、QID順、L2 cosine行列、audio窓平均&#xa;出力：experiments/exp1/&lt;run&gt;/{similarity.npy,heatmap.png,distribution.png,matrix_qids.json,metadata}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="3740" width="330" height="125" as="geometry"/></mxCell>
      <mxCell id="O24" value="experiments/exp1/&lt;run&gt;/{similarity.npy,heatmap.png,distribution.png,matrix_qids.json,metadata}" style="shape=note;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=10;" vertex="1" parent="1"><mxGeometry x="390" y="3765" width="310" height="75" as="geometry"/></mxCell>
      <mxCell id="out_C24" edge="1" parent="1" source="C24" target="O24" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;"/>
      <mxCell id="C25" value="12B make run-exp1-simmatrix-ordered&#xa;入力：runs + common_qids + num_recordings&#xa;処理：録音数降順・QID昇順で上位100件、欠落run除外&#xa;出力：experiments/exp1_ordered/&lt;run&gt;/{heatmap.png,distribution.png}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="3895" width="330" height="125" as="geometry"/></mxCell>
      <mxCell id="O25" value="experiments/exp1_ordered/&lt;run&gt;/{heatmap.png,distribution.png}" style="shape=note;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=10;" vertex="1" parent="1"><mxGeometry x="390" y="3920" width="310" height="75" as="geometry"/></mxCell>
      <mxCell id="out_C25" edge="1" parent="1" source="C25" target="O25" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;"/>
      <mxCell id="C26" value="12C make run-exp2-integrated-graph&#xa;入力：G/L/A runs + common_qids + num_recordings + graph&#xa;処理：各modality p95辺選択、union weight=max、layout共有&#xa;出力：experiments/exp2/&lt;run-combination&gt;/{graph,language,audio,integrated}.svg + metadata.json" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="4050" width="330" height="125" as="geometry"/></mxCell>
      <mxCell id="O26" value="experiments/exp2/&lt;run-combination&gt;/{graph,language,audio,integrated}.svg + metadata.json" style="shape=note;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=10;" vertex="1" parent="1"><mxGeometry x="390" y="4075" width="310" height="75" as="geometry"/></mxCell>
      <mxCell id="out_C26" edge="1" parent="1" source="C26" target="O26" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;"/>
      <mxCell id="C27" value="13A make run-exp3-sub1-audio&#xa;入力：audio run&#xa;処理：窓を録音平均、同QID別録音を正解、cosine順位評価&#xa;出力：experiments/exp3/sub1_audio/&lt;run&gt;/{per_query.tsv,summary.tsv,metadata.json}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="4205" width="330" height="125" as="geometry"/></mxCell>
      <mxCell id="O27" value="experiments/exp3/sub1_audio/&lt;run&gt;/{per_query.tsv,summary.tsv,metadata.json}" style="shape=note;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=10;" vertex="1" parent="1"><mxGeometry x="390" y="4230" width="310" height="75" as="geometry"/></mxCell>
      <mxCell id="out_C27" edge="1" parent="1" source="C27" target="O27" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;"/>
      <mxCell id="C28" value="13B make run-exp3-search&#xa;入力：taxon labels + selected G/L/A&#xa;処理：rank別label、G/L/A連結、pattern別top_k=10評価&#xa;出力：experiments/exp3/taxon_probe/&lt;pattern&gt;/&lt;rank&gt;/&lt;run&gt;/{per_query.tsv,summary.tsv,metadata.json}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="4360" width="330" height="125" as="geometry"/></mxCell>
      <mxCell id="O28" value="experiments/exp3/taxon_probe/&lt;pattern&gt;/&lt;rank&gt;/&lt;run&gt;/{per_query.tsv,summary.tsv,metadata.json}" style="shape=note;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=10;" vertex="1" parent="1"><mxGeometry x="390" y="4385" width="310" height="75" as="geometry"/></mxCell>
      <mxCell id="out_C28" edge="1" parent="1" source="C28" target="O28" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;"/>
      <mxCell id="C29" value="14 Taxon probe結果集約&#xa;入力：C28の結果&#xa;処理：rank・pattern・run組合せを保って集約&#xa;出力：experiments/exp3/taxon_probe/以下の集約結果" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="4515" width="330" height="125" as="geometry"/></mxCell>
      <mxCell id="O29" value="experiments/exp3/taxon_probe/以下の集約結果" style="shape=note;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=10;" vertex="1" parent="1"><mxGeometry x="390" y="4540" width="310" height="75" as="geometry"/></mxCell>
      <mxCell id="out_C29" edge="1" parent="1" source="C29" target="O29" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;"/>
      <mxCell id="C30" value="15 再現用成果物固定&#xa;入力：C01〜C29の入出力&#xa;処理：本体・行対応・run・QID・label・代表値を一組で保管&#xa;出力：再現用成果物一式" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="4670" width="330" height="125" as="geometry"/></mxCell>
