      <mxCell id="C20" value="9A-TransE make build-transe-embeddings&#xa;入力：taxonomy graph&#xa;処理：output128、epochs200、margin1、p_norm1、relation parent_taxon&#xa;出力：data/external/embeddings/graph/transe/&lt;run&gt;/embeddings.npy + qids + metadata" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="3120" width="330" height="125" as="geometry"/></mxCell>
