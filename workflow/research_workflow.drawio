  <diagram id="command-workflow" name="研究処理フローチャート（コマンド単位）">
    <mxGraphModel dx="1800" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0"><root>
      <mxCell id="0"/><mxCell id="1" parent="0"/>
      <mxCell id="C00" value="0 外部Wikidata検索&#xa;入力：外部検索定義&#xa;処理：Wikidata Query ServiceでQ5113下部の全ノードを検索&#xa;出力：data/raw/wikidata/query.tsv" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="330" height="125" as="geometry"/></mxCell>
      <mxCell id="O00" value="data/raw/wikidata/query.tsv" style="shape=note;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=10;" vertex="1" parent="1"><mxGeometry x="390" y="45" width="310" height="75" as="geometry"/></mxCell>
      <mxCell id="out_C00" edge="1" parent="1" source="C00" target="O00" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;"/>
      <mxCell id="C01" value="1B make extract-qids&#xa;入力：query.tsv&#xa;処理：item URL→QID抽出・重複除去・Q5113補完&#xa;出力：data/interim/wikidata/bird_qids.tsv" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="175" width="330" height="125" as="geometry"/></mxCell>
      <mxCell id="O01" value="data/interim/wikidata/bird_qids.tsv" style="shape=note;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=10;" vertex="1" parent="1"><mxGeometry x="390" y="200" width="310" height="75" as="geometry"/></mxCell>
      <mxCell id="out_C01" edge="1" parent="1" source="C01" target="O01" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;"/>
      <mxCell id="C02" value="1A make download-wikidata-dump&#xa;入力：Wikidata dump配布元&#xa;処理：対象QIDのentityを含むdumpを保存&#xa;出力：data/raw/wikidata/dumps/latest-all.json.bz2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="330" width="330" height="125" as="geometry"/></mxCell>
      <mxCell id="O02" value="data/raw/wikidata/dumps/latest-all.json.bz2" style="shape=note;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=10;" vertex="1" parent="1"><mxGeometry x="390" y="355" width="310" height="75" as="geometry"/></mxCell>
      <mxCell id="out_C02" edge="1" parent="1" source="C02" target="O02" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;"/>
      <mxCell id="C03" value="2 make extract-dump-json&#xa;入力：bird_qids.tsv + latest-all.json.bz2&#xa;処理：対象QIDだけshard配置へ抽出、既存JSON再利用&#xa;出力：data/interim/wikidata/json/&lt;1桁目&gt;/&lt;2桁目&gt;/Qxxxx.json" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="485" width="330" height="125" as="geometry"/></mxCell>
      <mxCell id="O03" value="data/interim/wikidata/json/&lt;1桁目&gt;/&lt;2桁目&gt;/Qxxxx.json" style="shape=note;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=10;" vertex="1" parent="1"><mxGeometry x="390" y="510" width="310" height="75" as="geometry"/></mxCell>
      <mxCell id="out_C03" edge="1" parent="1" source="C03" target="O03" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;"/>
      <mxCell id="C04" value="3 make build-ontology&#xa;入力：QID別entity JSON&#xa;処理：entityをontologyレコードへ変換&#xa;出力：data/processed/bird_ontology.pkl" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="640" width="330" height="125" as="geometry"/></mxCell>
      <mxCell id="O04" value="data/processed/bird_ontology.pkl" style="shape=note;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=10;" vertex="1" parent="1"><mxGeometry x="390" y="665" width="310" height="75" as="geometry"/></mxCell>
      <mxCell id="out_C04" edge="1" parent="1" source="C04" target="O04" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;"/>
      <mxCell id="C05" value="4A make build-graph&#xa;入力：bird_ontology.pkl&#xa;処理：QIDノード、parent_taxon→child有向辺、未知親placeholder&#xa;出力：data/processed/graph/bird_taxonomy_graph.pkl" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="795" width="330" height="125" as="geometry"/></mxCell>
      <mxCell id="O05" value="data/processed/graph/bird_taxonomy_graph.pkl" style="shape=note;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=10;" vertex="1" parent="1"><mxGeometry x="390" y="820" width="310" height="75" as="geometry"/></mxCell>
      <mxCell id="out_C05" edge="1" parent="1" source="C05" target="O05" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;"/>
      <mxCell id="C06" value="4D make build-taxon-labels&#xa;入力：taxonomy graph&#xa;処理：親方向の最近傍order/family祖先labelを割当&#xa;出力：data/processed/taxonomy/qid_taxon_labels.tsv + .json + meta.json" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="950" width="330" height="125" as="geometry"/></mxCell>
