      <mxCell id="d40" edge="1" parent="1" source="C22" target="C26" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;endArrow=block;html=1;"/>
      <mxCell id="d41" edge="1" parent="1" source="C05" target="C26" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;endArrow=block;html=1;"/>
      <mxCell id="d42" edge="1" parent="1" source="C06" target="C28" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;endArrow=block;html=1;"/>
      <mxCell id="d43" edge="1" parent="1" source="C28" target="C29" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;endArrow=block;html=1;"/>
      <mxCell id="d44" edge="1" parent="1" source="C24" target="C30" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;endArrow=block;html=1;"/>
      <mxCell id="d45" edge="1" parent="1" source="C25" target="C30" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;endArrow=block;html=1;"/>
      <mxCell id="d46" edge="1" parent="1" source="C26" target="C30" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;endArrow=block;html=1;"/>
      <mxCell id="d47" edge="1" parent="1" source="C27" target="C30" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;endArrow=block;html=1;"/>
      <mxCell id="d48" edge="1" parent="1" source="C29" target="C30" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;endArrow=block;html=1;"/>
      <mxCell id="S01" value="詳細：QIDリスト&#xa;query.tsvは外部検索結果。再検索せず、bird_qids.tsvがdump抽出対象を固定する。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="760" y="20" width="300" height="105" as="geometry"/></mxCell>
      <mxCell id="sedge0" edge="1" parent="1" source="C01" target="S01" style="edgeStyle=orthogonalEdgeStyle;dashed=1;endArrow=block;html=1;"/>
      <mxCell id="S02" value="詳細：ontology→graph&#xa;ontology 1レコード=graph 1ノード。parent_taxonは親→子の有向辺。未知親はplaceholder。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="760" y="175" width="300" height="105" as="geometry"/></mxCell>
      <mxCell id="sedge1" edge="1" parent="1" source="C05" target="S02" style="edgeStyle=orthogonalEdgeStyle;dashed=1;endArrow=block;html=1;"/>
      <mxCell id="S03" value="詳細：surfaceと行対応&#xa;surface_manifest 1行=embeddings 1行。surface_id/qid/ordinalで表層形を追跡する。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="760" y="330" width="300" height="105" as="geometry"/></mxCell>
      <mxCell id="sedge2" edge="1" parent="1" source="C14" target="S03" style="edgeStyle=orthogonalEdgeStyle;dashed=1;endArrow=block;html=1;"/>
      <mxCell id="S04" value="詳細：Taxon label&#xa;対象自身を除きparent方向の最近傍祖先。13Bの正解ラベルに使い、学習入力にはしない。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="760" y="485" width="300" height="105" as="geometry"/></mxCell>
      <mxCell id="sedge3" edge="1" parent="1" source="C06" target="S04" style="edgeStyle=orthogonalEdgeStyle;dashed=1;endArrow=block;html=1;"/>
      <mxCell id="S05" value="詳細：API録音とlocal audio&#xa;numRecordingsはAPI件数、recording_mapはID列、raw audioは取得成功ファイル。値を混同しない。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="760" y="640" width="300" height="105" as="geometry"/></mxCell>
      <mxCell id="sedge4" edge="1" parent="1" source="C08" target="S05" style="edgeStyle=orthogonalEdgeStyle;dashed=1;endArrow=block;html=1;"/>
      <mxCell id="S06" value="詳細：音声の粒度&#xa;audio_manifest 1行=窓。同じ(QID,relative_path)を平均し、実験では録音/QID単位へ集約する。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="760" y="795" width="300" height="105" as="geometry"/></mxCell>
      <mxCell id="sedge5" edge="1" parent="1" source="C11" target="S06" style="edgeStyle=orthogonalEdgeStyle;dashed=1;endArrow=block;html=1;"/>
      <mxCell id="S07" value="詳細：graph行対応&#xa;全graph手法でqids[i]とembeddings[i]を固定。initial embeddingは学習可能表現で固定one-hotではない。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="760" y="950" width="300" height="105" as="geometry"/></mxCell>
      <mxCell id="sedge6" edge="1" parent="1" source="C16" target="S07" style="edgeStyle=orthogonalEdgeStyle;dashed=1;endArrow=block;html=1;"/>
      <mxCell id="S08" value="詳細：graph手法&#xa;GCN/SAGE/GRACEは伝播、Node2Vecはwalk/window、TransEはparent_taxon三つ組。metadata/traceで条件確認。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="760" y="1105" width="300" height="105" as="geometry"/></mxCell>
      <mxCell id="sedge7" edge="1" parent="1" source="C19" target="S08" style="edgeStyle=orthogonalEdgeStyle;dashed=1;endArrow=block;html=1;"/>
      <mxCell id="S09" value="詳細：言語集約&#xa;max32 token、padding mask付きmean pooling。特殊token別除外とprojectionはない。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="760" y="1260" width="300" height="105" as="geometry"/></mxCell>
      <mxCell id="sedge8" edge="1" parent="1" source="C15" target="S09" style="edgeStyle=orthogonalEdgeStyle;dashed=1;endArrow=block;html=1;"/>
      <mxCell id="S10" value="詳細：run&#xa;runは1回の埋込み生成ディレクトリ。selected_runs.jsonが手法/モデルごとのpathを固定する。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="760" y="1415" width="300" height="105" as="geometry"/></mxCell>
      <mxCell id="sedge9" edge="1" parent="1" source="C21" target="S10" style="edgeStyle=orthogonalEdgeStyle;dashed=1;endArrow=block;html=1;"/>
      <mxCell id="S11" value="詳細：共通QID&#xa;common_qidsは集合交差。complete_qid_countはrunと他modality共通集合の交差件数。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="760" y="1570" width="300" height="105" as="geometry"/></mxCell>
      <mxCell id="sedge10" edge="1" parent="1" source="C22" target="S11" style="edgeStyle=orthogonalEdgeStyle;dashed=1;endArrow=block;html=1;"/>
      <mxCell id="S12" value="詳細：similarity matrix&#xa;同じQID順でL2正規化後の内積。12Bだけ録音数順上位100件へ制限する。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="760" y="1725" width="300" height="105" as="geometry"/></mxCell>
      <mxCell id="sedge11" edge="1" parent="1" source="C24" target="S12" style="edgeStyle=orthogonalEdgeStyle;dashed=1;endArrow=block;html=1;"/>
      <mxCell id="S13" value="詳細：統合graph&#xa;各modalityの対角除外p95以上を辺にし、同一pairをunion。union_thresholdは再選別しない。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="760" y="1880" width="300" height="105" as="geometry"/></mxCell>
      <mxCell id="sedge12" edge="1" parent="1" source="C26" target="S13" style="edgeStyle=orthogonalEdgeStyle;dashed=1;endArrow=block;html=1;"/>
      <mxCell id="S14" value="詳細：音声検索&#xa;query/候補は録音単位。同QID別録音のみ正解。正解0 queryは平均から除外する。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="760" y="2035" width="300" height="105" as="geometry"/></mxCell>
      <mxCell id="sedge13" edge="1" parent="1" source="C27" target="S14" style="edgeStyle=orthogonalEdgeStyle;dashed=1;endArrow=block;html=1;"/>
      <mxCell id="S15" value="詳細：Taxon probe&#xa;QID単位のG/L/A連結。自己除外、同label正解、分割なし。14でrank/pattern別集約。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="760" y="2190" width="300" height="105" as="geometry"/></mxCell>
      <mxCell id="sedge14" edge="1" parent="1" source="C28" target="S15" style="edgeStyle=orthogonalEdgeStyle;dashed=1;endArrow=block;html=1;"/>
      <mxCell id="S16" value="詳細：graph入力と辺&#xa;parent_taxonを親→子の有向辺、undirected=false。GCN/SAGE/GRACEは学習可能initial embedding＋自己ループで伝播。placeholderの扱いはqids/metadataで確認。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1120" y="20" width="330" height="125" as="geometry"/></mxCell>
      <mxCell id="sedge15" edge="1" parent="1" source="C16" target="S16" style="edgeStyle=orthogonalEdgeStyle;dashed=1;endArrow=block;html=1;"/>
      <mxCell id="S17" value="詳細：GCN/SAGE/GRACE学習&#xa;GCNはGAE negative sampling、SAGEはmean＋近傍[25,10]、GRACEはedge drop 2視点のin-batch contrastive loss。GRACE保存はencoder出力。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1120" y="165" width="330" height="125" as="geometry"/></mxCell>
      <mxCell id="sedge16" edge="1" parent="1" source="C18" target="S17" style="edgeStyle=orthogonalEdgeStyle;dashed=1;endArrow=block;html=1;"/>
      <mxCell id="S18" value="詳細：Node2Vec/TransE&#xa;Node2Vecは有向walk、p=q=1、window学習、行き止まりで終了。TransEはparent_taxonの(h,r,t)にhead/tail corruptionとmargin lossを適用。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1120" y="310" width="330" height="125" as="geometry"/></mxCell>
      <mxCell id="sedge17" edge="1" parent="1" source="C19" target="S18" style="edgeStyle=orthogonalEdgeStyle;dashed=1;endArrow=block;html=1;"/>
      <mxCell id="S19" value="詳細：graph出力対応&#xa;embeddings.npy[i]↔qids.json[i]。training_trace等は条件確認用。L2正規化は実験側のcosine計算時に行う。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1120" y="455" width="330" height="125" as="geometry"/></mxCell>
      <mxCell id="sedge18" edge="1" parent="1" source="C20" target="S19" style="edgeStyle=orthogonalEdgeStyle;dashed=1;endArrow=block;html=1;"/>
      <mxCell id="S20" value="詳細：音声埋込み行&#xa;wav2vec2=16kHz・全体・時間平均、BirdNET=48kHz・3秒窓・pb。Perch=別環境・32kHz相当・5秒窓、内部checkpoint/集約は未確認。manifest行がembeddings行に対応。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1120" y="600" width="330" height="125" as="geometry"/></mxCell>
      <mxCell id="sedge19" edge="1" parent="1" source="C11" target="S20" style="edgeStyle=orthogonalEdgeStyle;dashed=1;endArrow=block;html=1;"/>
      <mxCell id="S21" value="詳細：Taxon label探索&#xa;parent_taxonを上方向へ辿る最近傍order/family祖先をlabel_qidにする。label_name/distanceを出力。親欠損・循環・該当なしは空欄。複数親は推測選択しない。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1120" y="745" width="330" height="125" as="geometry"/></mxCell>
      <mxCell id="sedge20" edge="1" parent="1" source="C06" target="S21" style="edgeStyle=orthogonalEdgeStyle;dashed=1;endArrow=block;html=1;"/>
      <mxCell id="S22" value="詳細：代表値とrun探索&#xa;言語は(qid,ordinal,surface_id,text)先頭。音声は(QID,path)窓平均後、共通pathから代表を選ぶ。selected_runs優先、autoは必要ファイル完了run。13Bはselectedのみ。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1120" y="890" width="330" height="125" as="geometry"/></mxCell>
      <mxCell id="sedge21" edge="1" parent="1" source="C21" target="S22" style="edgeStyle=orthogonalEdgeStyle;dashed=1;endArrow=block;html=1;"/>
      <mxCell id="S23" value="詳細：共通集合と録音数&#xa;complete_qid_countはrunと他modality共通集合の交差件数。12Bは録音数表にないQIDを除外、12Cは0扱い。numRecordingsはAPI値でlocal file数ではない。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1120" y="1035" width="330" height="125" as="geometry"/></mxCell>
      <mxCell id="sedge22" edge="1" parent="1" source="C22" target="S23" style="edgeStyle=orthogonalEdgeStyle;dashed=1;endArrow=block;html=1;"/>
      <mxCell id="S24" value="詳細：Experiment 1計算&#xa;行L2正規化後S=XX^T、対角=1.0。12AはQID昇順全件、12Bは(-numRecordings,QID)上位100。12Aはnpy/ID等、12Bはheatmap/distributionを出力。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1120" y="1180" width="330" height="125" as="geometry"/></mxCell>
      <mxCell id="sedge23" edge="1" parent="1" source="C24" target="S24" style="edgeStyle=orthogonalEdgeStyle;dashed=1;endArrow=block;html=1;"/>
      <mxCell id="S25" value="詳細：Experiment 2閾値/描画&#xa;対角除外上三角のp95（NumPy線形補間）、score以上を辺にする。union weight=max、union_thresholdは再選別せず記録。全QID/孤立ノードを描画しspring_layout(seed=42,k=.85,iterations=200)を共有。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1120" y="1325" width="330" height="125" as="geometry"/></mxCell>
      <mxCell id="sedge24" edge="1" parent="1" source="C26" target="S25" style="edgeStyle=orthogonalEdgeStyle;dashed=1;endArrow=block;html=1;"/>
      <mxCell id="S26" value="詳細：13A評価&#xa;録音単位で同path自身を除外、同QID別録音を正解。AP=全候補順位のprecision合計/全relevant数、MRR=最初の正解の逆数、nDCG@10/50/100。正解0 queryは平均から除外。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1120" y="1470" width="330" height="125" as="geometry"/></mxCell>
      <mxCell id="sedge25" edge="1" parent="1" source="C27" target="S26" style="edgeStyle=orthogonalEdgeStyle;dashed=1;endArrow=block;html=1;"/>
      <mxCell id="S27" value="詳細：13B評価&#xa;P@k=正解/k、R@k=正解/全正解、F1=調和平均、AP@10=precision合計/全正解、RRはtop10内の最初の正解。正解0も平均含むがevaluated_query_countから除外。境界同点規則は未確認。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1120" y="1615" width="330" height="125" as="geometry"/></mxCell>
      <mxCell id="sedge26" edge="1" parent="1" source="C28" target="S27" style="edgeStyle=orthogonalEdgeStyle;dashed=1;endArrow=block;html=1;"/>
      <mxCell id="S28" value="詳細：再利用・固定境界&#xa;本体、行対応、selected_runs、対象QID、labels、代表値、metadataを一組で参照。既存/partial/failedの再利用条件は実装依存。日時・版・hash・依存環境が無ければ未確認/未記録。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1120" y="1760" width="330" height="125" as="geometry"/></mxCell>
      <mxCell id="sedge27" edge="1" parent="1" source="C30" target="S28" style="edgeStyle=orthogonalEdgeStyle;dashed=1;endArrow=block;html=1;"/>
      <mxCell id="C08M" value="8準備 make download-audio-models&#xa;処理：音声モデルcacheを事前取得&#xa;出力：data/external/models/audio/huggingface/等" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="760" y="2350" width="320" height="115" as="geometry"/></mxCell>
      <mxCell id="C10R" value="7補修 make repair-xeno-canto-audio&#xa;処理：raw audioをdecode検査し修復reportを生成&#xa;出力：xeno_canto_audio_repair.tsv/json" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="760" y="2505" width="320" height="115" as="geometry"/></mxCell>
      <mxCell id="C10F" value="8F make finetune-wav2vec2-crossval&#xa;処理：raw audioで5-fold wav2vec2 fine-tune&#xa;出力：data/external/models/audio/wav2vec2-finetuned/wav2vec2-model_0..4/" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="760" y="2660" width="320" height="115" as="geometry"/></mxCell>
      <mxCell id="C11F" value="8F make build-audio-embeddings-wav2vec2-finetuned&#xa;処理：foldモデルから音声埋込みを生成&#xa;出力：data/external/embeddings/audio/wav2vec2-finetuned/..." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="760" y="2815" width="320" height="115" as="geometry"/></mxCell>
      <mxCell id="C22S" value="10確認 make inspect-multimodal-sources&#xa;処理：selected/auto-discover runとmetadataを検査&#xa;出力：診断標準出力" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="760" y="2970" width="320" height="115" as="geometry"/></mxCell>
      <mxCell id="C22G" value="準備 make check-gpu / check-birdnet-gpu&#xa;処理：CUDA/TensorFlowのGPU認識を確認&#xa;出力：診断標準出力" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="760" y="3125" width="320" height="115" as="geometry"/></mxCell>
