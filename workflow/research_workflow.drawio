      <mxCell id="out_C06" edge="1" parent="1" source="C06" target="O06" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;"/>
      <mxCell id="C07" value="4C make extract-xeno-canto-ids&#xa;入力：ontology + taxonomy graph&#xa;処理：species IDを持つ末端QIDを抽出&#xa;出力：data/interim/wikidata/bird_xeno_canto_ids.tsv" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="1105" width="330" height="125" as="geometry"/></mxCell>
      <mxCell id="O07" value="data/interim/wikidata/bird_xeno_canto_ids.tsv" style="shape=note;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=10;" vertex="1" parent="1"><mxGeometry x="390" y="1130" width="310" height="75" as="geometry"/></mxCell>
      <mxCell id="out_C07" edge="1" parent="1" source="C07" target="O07" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;"/>
      <mxCell id="C08" value="5 make fetch-xeno-canto-recording-json&#xa;入力：bird_xeno_canto_ids.tsv + API key&#xa;処理：sp/q:A、page=1、per_page=20、since=2025-05-01で取得&#xa;出力：data/interim/xeno-canto/api_recordings/&lt;QID&gt;/page*.json" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="1260" width="330" height="125" as="geometry"/></mxCell>
