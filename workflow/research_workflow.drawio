      <mxCell id="out_C08" edge="1" parent="1" source="C08" target="O08" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;"/>
      <mxCell id="C09" value="6 make extract-xeno-canto-recording-ids&#xa;入力：API page JSON&#xa;処理：ページ順にrecording IDを抽出・重複除去&#xa;出力：data/interim/xeno-canto/recording_map.json" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="1415" width="330" height="125" as="geometry"/></mxCell>
      <mxCell id="O09" value="data/interim/xeno-canto/recording_map.json" style="shape=note;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=10;" vertex="1" parent="1"><mxGeometry x="390" y="1440" width="310" height="75" as="geometry"/></mxCell>
      <mxCell id="out_C09" edge="1" parent="1" source="C09" target="O09" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;"/>
      <mxCell id="C10" value="7 make fetch-xeno-canto-audio&#xa;入力：recording_map.json + recording URL&#xa;処理：品質A、QIDごと最大20件、失敗補充なし、15秒切出し&#xa;出力：data/raw/xeno-canto/&lt;QID&gt;/&lt;recording_id&gt;.&lt;ext&gt; + manifest" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="1570" width="330" height="125" as="geometry"/></mxCell>
