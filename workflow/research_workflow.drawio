      <mxCell id="C19" value="9A-Node2Vec make build-node2vec-embeddings&#xa;入力：taxonomy graph&#xa;処理：output128、walk40、walks10、window10、negative5、batch8192&#xa;出力：data/external/embeddings/graph/node2vec/&lt;run&gt;/embeddings.npy + qids + metadata" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="2965" width="330" height="125" as="geometry"/></mxCell>
