      <mxCell id="out_C15" edge="1" parent="1" source="C15" target="O15" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;"/>
      <mxCell id="C16" value="9A-GCN make build-gcn-embeddings&#xa;入力：taxonomy graph&#xa;処理：hidden32/output128/layers2/epochs200/negative20/initial embedding&#xa;出力：data/external/embeddings/graph/gcn/&lt;run&gt;/embeddings.npy + qids + metadata" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="2500" width="330" height="125" as="geometry"/></mxCell>
      <mxCell id="O16" value="data/external/embeddings/graph/gcn/&lt;run&gt;/embeddings.npy + qids + metadata" style="shape=note;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=10;" vertex="1" parent="1"><mxGeometry x="390" y="2525" width="310" height="75" as="geometry"/></mxCell>
