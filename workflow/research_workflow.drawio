      <mxCell id="out_C10" edge="1" parent="1" source="C10" target="O10" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;"/>
      <mxCell id="C11" value="8W make build-audio-embeddings-wav2vec2&#xa;入力：raw audio&#xa;処理：wav2vec2-base-960h、16kHz、ファイル全体、時間平均&#xa;出力：data/external/embeddings/audio/wav2vec2/&lt;model&gt;/&lt;run&gt;/embeddings.npy + manifest" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="1725" width="330" height="125" as="geometry"/></mxCell>
