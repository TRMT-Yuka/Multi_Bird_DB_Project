      <mxCell id="out_C12" edge="1" parent="1" source="C12" target="O12" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;"/>
      <mxCell id="C13" value="8P make build-audio-embeddings-perch&#xa;入力：raw audio（別環境）&#xa;処理：旧公式Perch、32kHz、5秒窓、内部集約は未確認&#xa;出力：data/external/embeddings/audio/perch/&lt;model&gt;/&lt;run&gt;/embeddings.npy + manifest" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="2035" width="330" height="125" as="geometry"/></mxCell>
