        <mxCell id="O14" value="集約済みTaxon probe結果" style="shape=note;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="4580" y="620" width="190" height="55" as="geometry"/></mxCell>

        <mxCell id="eW01" edge="1" parent="1" source="W00" target="O01" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;endArrow=block;html=1;"/>
