  <diagram id="command-workflow" name="研究処理フローチャート（コマンド単位）">
    <mxGraphModel dx="1800" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0"><root>
      <mxCell id="0"/><mxCell id="1" parent="0"/>
      <mxCell id="C00" value="0 外部Wikidata検索&#xa;入力：外部検索定義&#xa;処理：Wikidata Query ServiceでQ5113下部の全ノードを検索&#xa;出力：data/raw/wikidata/query.tsv" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="330" height="125" as="geometry"/></mxCell>
      <mxCell id="O00" value="data/raw/wikidata/query.tsv" style="shape=note;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=10;" vertex="1" parent="1"><mxGeometry x="390" y="45" width="310" height="75" as="geometry"/></mxCell>
      <mxCell id="out_C00" edge="1" parent="1" source="C00" target="O00" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;"/>
      <mxCell id="C01" value="1B make extract-qids&#xa;入力：query.tsv&#xa;処理：item URL→QID抽出・重複除去・Q5113補完&#xa;出力：data/interim/wikidata/bird_qids.tsv" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="175" width="330" height="125" as="geometry"/></mxCell>
      <mxCell id="O01" value="data/interim/wikidata/bird_qids.tsv" style="shape=note;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=10;" vertex="1" parent="1"><mxGeometry x="390" y="200" width="310" height="75" as="geometry"/></mxCell>
      <mxCell id="out_C01" edge="1" parent="1" source="C01" target="O01" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;"/>
      <mxCell id="C02" value="1A make download-wikidata-dump&#xa;入力：Wikidata dump配布元&#xa;処理：対象QIDのentityを含むdumpを保存&#xa;出力：data/raw/wikidata/dumps/latest-all.json.bz2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="330" width="330" height="125" as="geometry"/></mxCell>
      <mxCell id="O02" value="data/raw/wikidata/dumps/latest-all.json.bz2" style="shape=note;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=10;" vertex="1" parent="1"><mxGeometry x="390" y="355" width="310" height="75" as="geometry"/></mxCell>
      <mxCell id="out_C02" edge="1" parent="1" source="C02" target="O02" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;"/>
      <mxCell id="C03" value="2 make extract-dump-json&#xa;入力：bird_qids.tsv + latest-all.json.bz2&#xa;処理：対象QIDだけshard配置へ抽出、既存JSON再利用&#xa;出力：data/interim/wikidata/json/&lt;1桁目&gt;/&lt;2桁目&gt;/Qxxxx.json" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="485" width="330" height="125" as="geometry"/></mxCell>
      <mxCell id="O03" value="data/interim/wikidata/json/&lt;1桁目&gt;/&lt;2桁目&gt;/Qxxxx.json" style="shape=note;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=10;" vertex="1" parent="1"><mxGeometry x="390" y="510" width="310" height="75" as="geometry"/></mxCell>
      <mxCell id="out_C03" edge="1" parent="1" source="C03" target="O03" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;"/>
      <mxCell id="C04" value="3 make build-ontology&#xa;入力：QID別entity JSON&#xa;処理：entityをontologyレコードへ変換&#xa;出力：data/processed/bird_ontology.pkl" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="640" width="330" height="125" as="geometry"/></mxCell>
      <mxCell id="O04" value="data/processed/bird_ontology.pkl" style="shape=note;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=10;" vertex="1" parent="1"><mxGeometry x="390" y="665" width="310" height="75" as="geometry"/></mxCell>
      <mxCell id="out_C04" edge="1" parent="1" source="C04" target="O04" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;"/>
      <mxCell id="C05" value="4A make build-graph&#xa;入力：bird_ontology.pkl&#xa;処理：QIDノード、parent_taxon→child有向辺、未知親placeholder&#xa;出力：data/processed/graph/bird_taxonomy_graph.pkl" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="795" width="330" height="125" as="geometry"/></mxCell>
      <mxCell id="O05" value="data/processed/graph/bird_taxonomy_graph.pkl" style="shape=note;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=10;" vertex="1" parent="1"><mxGeometry x="390" y="820" width="310" height="75" as="geometry"/></mxCell>
      <mxCell id="out_C05" edge="1" parent="1" source="C05" target="O05" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;"/>
      <mxCell id="C06" value="4D make build-taxon-labels&#xa;入力：taxonomy graph&#xa;処理：親方向の最近傍order/family祖先labelを割当&#xa;出力：data/processed/taxonomy/qid_taxon_labels.tsv + .json + meta.json" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="950" width="330" height="125" as="geometry"/></mxCell>
      <mxCell id="O06" value="data/processed/taxonomy/qid_taxon_labels.tsv + .json + meta.json" style="shape=note;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=10;" vertex="1" parent="1"><mxGeometry x="390" y="975" width="310" height="75" as="geometry"/></mxCell>
      <mxCell id="out_C06" edge="1" parent="1" source="C06" target="O06" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;"/>
      <mxCell id="C07" value="4C make extract-xeno-canto-ids&#xa;入力：ontology + taxonomy graph&#xa;処理：species IDを持つ末端QIDを抽出&#xa;出力：data/interim/wikidata/bird_xeno_canto_ids.tsv" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="1105" width="330" height="125" as="geometry"/></mxCell>
      <mxCell id="O07" value="data/interim/wikidata/bird_xeno_canto_ids.tsv" style="shape=note;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=10;" vertex="1" parent="1"><mxGeometry x="390" y="1130" width="310" height="75" as="geometry"/></mxCell>
      <mxCell id="out_C07" edge="1" parent="1" source="C07" target="O07" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;"/>
      <mxCell id="C08" value="5 make fetch-xeno-canto-recording-json&#xa;入力：bird_xeno_canto_ids.tsv + API key&#xa;処理：sp/q:A、page=1、per_page=20、since=2025-05-01で取得&#xa;出力：data/interim/xeno-canto/api_recordings/&lt;QID&gt;/page*.json" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="1260" width="330" height="125" as="geometry"/></mxCell>
      <mxCell id="O08" value="data/interim/xeno-canto/api_recordings/&lt;QID&gt;/page*.json" style="shape=note;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=10;" vertex="1" parent="1"><mxGeometry x="390" y="1285" width="310" height="75" as="geometry"/></mxCell>
      <mxCell id="out_C08" edge="1" parent="1" source="C08" target="O08" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;"/>
      <mxCell id="C09" value="6 make extract-xeno-canto-recording-ids&#xa;入力：API page JSON&#xa;処理：ページ順にrecording IDを抽出・重複除去&#xa;出力：data/interim/xeno-canto/recording_map.json" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="1415" width="330" height="125" as="geometry"/></mxCell>
      <mxCell id="O09" value="data/interim/xeno-canto/recording_map.json" style="shape=note;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=10;" vertex="1" parent="1"><mxGeometry x="390" y="1440" width="310" height="75" as="geometry"/></mxCell>
      <mxCell id="out_C09" edge="1" parent="1" source="C09" target="O09" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;"/>
      <mxCell id="C10" value="7 make fetch-xeno-canto-audio&#xa;入力：recording_map.json + recording URL&#xa;処理：品質A、QIDごと最大20件、失敗補充なし、15秒切出し&#xa;出力：data/raw/xeno-canto/&lt;QID&gt;/&lt;recording_id&gt;.&lt;ext&gt; + manifest" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="1570" width="330" height="125" as="geometry"/></mxCell>
      <mxCell id="O10" value="data/raw/xeno-canto/&lt;QID&gt;/&lt;recording_id&gt;.&lt;ext&gt; + manifest" style="shape=note;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=10;" vertex="1" parent="1"><mxGeometry x="390" y="1595" width="310" height="75" as="geometry"/></mxCell>
      <mxCell id="out_C10" edge="1" parent="1" source="C10" target="O10" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;"/>
      <mxCell id="C11" value="8W make build-audio-embeddings-wav2vec2&#xa;入力：raw audio&#xa;処理：wav2vec2-base-960h、16kHz、ファイル全体、時間平均&#xa;出力：data/external/embeddings/audio/wav2vec2/&lt;model&gt;/&lt;run&gt;/embeddings.npy + manifest" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="1725" width="330" height="125" as="geometry"/></mxCell>
      <mxCell id="O11" value="data/external/embeddings/audio/wav2vec2/&lt;model&gt;/&lt;run&gt;/embeddings.npy + manifest" style="shape=note;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=10;" vertex="1" parent="1"><mxGeometry x="390" y="1750" width="310" height="75" as="geometry"/></mxCell>
      <mxCell id="out_C11" edge="1" parent="1" source="C11" target="O11" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;"/>
      <mxCell id="C12" value="8B make build-audio-embeddings-birdnet-gpu&#xa;入力：raw audio&#xa;処理：BirdNET acoustic 2.4、pb、48kHz、3秒窓&#xa;出力：data/external/embeddings/audio/birdnet/&lt;model&gt;/&lt;run&gt;/embeddings.npy + manifest" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="1880" width="330" height="125" as="geometry"/></mxCell>
      <mxCell id="O12" value="data/external/embeddings/audio/birdnet/&lt;model&gt;/&lt;run&gt;/embeddings.npy + manifest" style="shape=note;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=10;" vertex="1" parent="1"><mxGeometry x="390" y="1905" width="310" height="75" as="geometry"/></mxCell>
      <mxCell id="out_C12" edge="1" parent="1" source="C12" target="O12" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;"/>
      <mxCell id="C13" value="8P make build-audio-embeddings-perch&#xa;入力：raw audio（別環境）&#xa;処理：旧公式Perch、32kHz、5秒窓、内部集約は未確認&#xa;出力：data/external/embeddings/audio/perch/&lt;model&gt;/&lt;run&gt;/embeddings.npy + manifest" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="2035" width="330" height="125" as="geometry"/></mxCell>
