      <mxCell id="C18" value="9A-GRACE make build-grace-embeddings&#xa;入力：taxonomy graph&#xa;処理：GCN encoder、hidden32/output128/projection128、edge drop .2/.4&#xa;出力：data/external/embeddings/graph/grace/&lt;run&gt;/embeddings.npy + qids + metadata" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="2810" width="330" height="125" as="geometry"/></mxCell>
