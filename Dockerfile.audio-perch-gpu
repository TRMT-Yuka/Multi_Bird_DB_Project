ARG BASE_IMAGE=nvcr.io/nvidia/tensorflow:25.02-tf2-py3
FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive     PIP_DISABLE_PIP_VERSION_CHECK=1     PIP_NO_CACHE_DIR=1     PYTHONDONTWRITEBYTECODE=1     PYTHONUNBUFFERED=1     HF_HOME=/workspace/data/external/models/audio/huggingface     MPLCONFIGDIR=/tmp/matplotlib     HOME=/tmp     USER=trmt     LOGNAME=trmt     USERNAME=trmt     TORCHINDUCTOR_CACHE_DIR=/tmp/torchinductor

WORKDIR /workspace

RUN apt-get update     && apt-get install -y --no-install-recommends ffmpeg libsndfile1 git curl ca-certificates     && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README*.md Makefile /workspace/
COPY src /workspace/src

RUN python3 -m pip install --upgrade pip setuptools wheel     && printf 'tensorflow==2.17.0+nv25.2
' >/tmp/tf-constraints.txt     && python3 -m pip install -c /tmp/tf-constraints.txt -e '.[audio-perch]'     && rm -f /tmp/tf-constraints.txt

CMD ["bash"]
